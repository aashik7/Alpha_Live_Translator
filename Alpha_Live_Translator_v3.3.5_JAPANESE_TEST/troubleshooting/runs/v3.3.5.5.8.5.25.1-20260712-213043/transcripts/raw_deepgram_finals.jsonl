{"run_id": "live-v3.3.5.5.8.5.25.1-20260712-213043-0cd8fe2f", "source": "deepgram_final_ingress", "is_final": true, "raw_text": "新製品の発売により量産サプリメント市場で", "accepted_by_gate": true, "timestamp": 1783859693.791943}
{"run_id": "live-v3.3.5.5.8.5.25.1-20260712-213043-0cd8fe2f", "source": "deepgram_final_ingress", "is_final": true, "raw_text": "さらなるケアの拡大を見込ん", "accepted_by_gate": true, "timestamp": 1783859694.9999564}
{"run_id": "live-v3.3.5.5.8.5.25.1-20260712-213043-0cd8fe2f", "source": "deepgram_final_ingress", "is_final": true, "raw_text": "続いて覚悟会社の", "accepted_by_gate": true, "timestamp": 1783859699.999805}
