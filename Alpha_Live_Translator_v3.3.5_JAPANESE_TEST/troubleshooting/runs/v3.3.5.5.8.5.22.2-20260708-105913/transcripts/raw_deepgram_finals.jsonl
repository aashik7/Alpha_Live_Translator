{"run_id": "live-v3.3.5.5.8.5.22.2-20260708-105913-a29715c0", "source": "deepgram_final_ingress", "is_final": true, "raw_text": "丁寧ですね。すみませんの謙譲語になります。", "accepted_by_gate": true, "timestamp": 1783476477.290586}
{"run_id": "live-v3.3.5.5.8.5.22.2-20260708-105913-a29715c0", "source": "deepgram_final_ingress", "is_final": true, "raw_text": "恐れ入ります。", "accepted_by_gate": true, "timestamp": 1783476478.7627504}
