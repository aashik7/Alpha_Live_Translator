{"run_id": "live-v3.3.5.5.8.5.22.2-20260708-105913-a29715c0", "source": "deepgram_final_ingress", "is_final": true, "raw_text": "では、今回も皆さんリピートしてくだい。", "accepted_by_gate": true, "timestamp": 1783476332.6568675}
