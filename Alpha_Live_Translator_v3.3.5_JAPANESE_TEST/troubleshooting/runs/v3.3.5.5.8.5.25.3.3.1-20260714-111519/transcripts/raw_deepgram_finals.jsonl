{"run_id": "live-v3.3.5.5.8.5.25.3.3.1-20260714-111519-14b93a8a", "source": "deepgram_final_ingress", "is_final": true, "raw_text": "営業利益は十億六千百万円となり、前年同期比", "accepted_by_gate": true, "timestamp": 1783995394.8242764}
