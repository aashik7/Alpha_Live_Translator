{"run_id": "live-v3.3.5.5.8.5.25.3.3-20260714-022524-7e5cd86e", "source": "deepgram_final_ingress", "is_final": true, "raw_text": "さらなるペアの拡大を見込ん", "accepted_by_gate": true, "timestamp": 1783963791.6420913}
{"run_id": "live-v3.3.5.5.8.5.25.3.3-20260714-022524-7e5cd86e", "source": "deepgram_final_ingress", "is_final": true, "raw_text": "続いて各子会社の", "accepted_by_gate": true, "timestamp": 1783963796.7057793}
