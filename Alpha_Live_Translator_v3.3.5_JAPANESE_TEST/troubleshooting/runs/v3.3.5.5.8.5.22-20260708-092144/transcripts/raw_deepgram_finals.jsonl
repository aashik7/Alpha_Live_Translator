{"run_id": "live-v3.3.5.5.8.5.22-20260708-092144-d784f342", "source": "deepgram_final_ingress", "is_final": true, "raw_text": "改まった表現についてシェアしたいと思います。", "accepted_by_gate": true, "timestamp": 1783470709.3509705}
