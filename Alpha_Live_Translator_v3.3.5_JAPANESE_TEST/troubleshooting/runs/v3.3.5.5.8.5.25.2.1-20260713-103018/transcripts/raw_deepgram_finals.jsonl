{"run_id": "live-v3.3.5.5.8.5.25.2.1-20260713-103018-2c0bfc93", "source": "deepgram_final_ingress", "is_final": true, "raw_text": "続いて貸借対照表です", "accepted_by_gate": true, "timestamp": 1783906380.4452934}
