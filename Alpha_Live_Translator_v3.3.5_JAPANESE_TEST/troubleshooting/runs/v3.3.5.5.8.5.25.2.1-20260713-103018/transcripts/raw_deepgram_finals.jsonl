{"run_id": "live-v3.3.5.5.8.5.25.2.1-20260713-103018-2c0bfc93", "source": "deepgram_final_ingress", "is_final": true, "raw_text": "保育施設の新設等症に", "accepted_by_gate": true, "timestamp": 1783906391.251105}
{"run_id": "live-v3.3.5.5.8.5.25.2.1-20260713-103018-2c0bfc93", "source": "deepgram_final_ingress", "is_final": true, "raw_text": "資産合計は二十八億", "accepted_by_gate": true, "timestamp": 1783906396.3104286}
{"run_id": "live-v3.3.5.5.8.5.25.2.1-20260713-103018-2c0bfc93", "source": "deepgram_final_ingress", "is_final": true, "raw_text": "7100万円増加しまた。", "accepted_by_gate": true, "timestamp": 1783906397.7623703}
{"run_id": "live-v3.3.5.5.8.5.25.2.1-20260713-103018-2c0bfc93", "source": "deepgram_final_ingress", "is_final": true, "raw_text": "スタイグは主に", "accepted_by_gate": true, "timestamp": 1783906400.7008617}
{"run_id": "live-v3.3.5.5.8.5.25.2.1-20260713-103018-2c0bfc93", "source": "deepgram_final_ingress", "is_final": true, "raw_text": "蔵書に", "accepted_by_gate": true, "timestamp": 1783906402.5312514}
