{"run_id": "live-v3.3.5.5.8.5.25.2.1-20260713-103018-2c0bfc93", "source": "deepgram_final_ingress", "is_final": true, "raw_text": "主力の保育サービスにおいて増収となりました", "accepted_by_gate": true, "timestamp": 1783906265.0835288}
{"run_id": "live-v3.3.5.5.8.5.25.2.1-20260713-103018-2c0bfc93", "source": "deepgram_final_ingress", "is_final": true, "raw_text": "、不動産事業は前期に計上した", "accepted_by_gate": true, "timestamp": 1783906270.077568}
{"run_id": "live-v3.3.5.5.8.5.25.2.1-20260713-103018-2c0bfc93", "source": "deepgram_final_ingress", "is_final": true, "raw_text": "大型不動産売却案件の反動により", "accepted_by_gate": true, "timestamp": 1783906273.9257019}
