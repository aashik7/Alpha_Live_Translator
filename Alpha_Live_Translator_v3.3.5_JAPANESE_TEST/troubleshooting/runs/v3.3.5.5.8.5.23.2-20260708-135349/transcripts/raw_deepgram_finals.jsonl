{"run_id": "live-v3.3.5.5.8.5.23.2-20260708-135349-e837ae47", "source": "deepgram_final_ingress", "is_final": true, "raw_text": "皆さんこんにちは。", "accepted_by_gate": true, "timestamp": 1783486441.5254285}
