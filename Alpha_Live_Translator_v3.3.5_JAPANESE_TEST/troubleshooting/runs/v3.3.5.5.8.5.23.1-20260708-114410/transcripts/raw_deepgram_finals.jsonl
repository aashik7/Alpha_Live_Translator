{"run_id": "live-v3.3.5.5.8.5.23.1-20260708-114410-a4511ee1", "source": "deepgram_final_ingress", "is_final": true, "raw_text": "もチンがいろいろとお世話になております。", "accepted_by_gate": true, "timestamp": 1783478957.6226413}
