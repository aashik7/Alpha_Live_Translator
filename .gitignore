# Secrets
.env
.env.*
!.env.example

# The user's own UI preferences, written by the app at runtime.
Alpha_Live_Translator/user_settings.json

# Local-only archive (old versions + bulky run data)
_archive/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.cache/

# Logs and bulky generated run artifacts
*.log
**/japanese_accuracy.log
**/logs/
**/logs/**/*.jsonl
**/orchestrator_stdout.txt
**/orchestrator_stderr.txt

# Troubleshooting evidence / runs / packages (keep local; do not track)
troubleshooting/
**/troubleshooting/
**/troubleshooting/runs/
**/troubleshooting/smoke_tests/
**/troubleshooting/**/FINAL_UPLOAD/
**/troubleshooting/**/staging*/
**/quarantine/
**/_cleanup_archive/
**/implementation_evidence/
**/LATEST_LIVE_RUN_ARTIFACTS_INDEX.txt
**/UPLOAD_PACKAGE_INDEX.txt
**/orchestrator_stdout.txt
**/orchestrator_stderr.txt

# Archives / checksums / dumps
**/*.zip
**/*.7z
**/*.sha256
**/*.jsonl
*.csv

# Probe / temp junk
_probe_*
**/_probe_*
_*.txt
**/_scan_summary.txt
git_add_stderr.txt
**/debug/

# Audio / capture / temp
*.wav
*.mp3
*.ogg
*.flac
*.m4a
*.aac
*.wma
*.aiff
*.opus
*.pcm
*.raw
tmp/
temp/
*.tmp
*.temp

# Graphify generated knowledge graph (rebuild: graphify update .)
graphify-out/
**/graphify-out/

# OS / editor / agent tooling (local)
.DS_Store
Thumbs.db
desktop.ini
.cursor/
.agents/
.vscode/
*.swp
# Keep Graphify Cursor rule trackable if .cursor/ is ever un-ignored:
!.cursor/rules/graphify.mdc

# Item 49 packaging output. `tools/build_bundle.py` writes a ~96 MB bundle
# and a cached CPython download here; both are rebuildable from the lock
# file and must never be committed.
Alpha_Live_Translator/build/

# Item 49 phase 2: the delivered build's API keys. NEVER commit these --
# a key in git history cannot be recalled from clones that already exist.
Alpha_Live_Translator/installer/keys.local.ini
